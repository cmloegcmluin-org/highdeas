.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Secrets — never commit
.env

# Your own vocabulary for transcription — names and terms, some of them people's —
# with the key that reads the names sheet and the names last read from it
/lexicon.md
/lexicon-sources.md
/google-key.json
/sheet-names.json

# Google Cloud service-account key (README: "Google Drive per-memo folder links" says to
# save this outside the repo, but this backstops that in case it ever lands in here anyway)
highdeas-drive-reader.json
*.serviceaccount.json

# Same backstop, for the OAuth client secret and refresh-token files "Google Drive
# native Doc filing" has Douglas save outside the repo (README + agent-inbox/gdoc-export.txt)
highdeas-drive-docs-client.json
highdeas-drive-docs-token.json

# Local database, the processed-audio bin, and the remembered window geometry
memos.db
bin/
window.json

# Generated, machine-specific taskbar shortcut (rebuild with "Create Highdeas Shortcut.bat")
/Highdeas.lnk

# The Mac shell's copy of the icon, which tools/make_mac_app.sh replaces wholesale from
# tools/Highdeas.icon on every build — one artwork source, so this is only ever derived.
# Tracked, it went stale the first time the icon changed and then dirtied the running
# app's own checkout on the next rebuild, which is enough to make its `git pull` refuse.
/mac/HighdeasMac/Highdeas.icon/

# Claude Code worktrees and local settings
.claude/

# Xcode / Swift build products and per-user state (ios/)
xcuserdata/
ios/**/.build/
ios/**/DerivedData/

# Xcode / SwiftPM build artifacts
ios/HighdeasKit/.build/
ios/build/
*.xcuserdatad/
